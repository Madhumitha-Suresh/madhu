<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creative Web Layout</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
        }

        /* Header */
        header {
            background: linear-gradient(90deg, #1e3c72, #2a5298);
            color: white;
            text-align: center;
            padding: 25px;
            border-bottom: 5px solid #ffcc00;
            position: relative;
        }

        header h1 {
            margin-bottom: 8px;
        }

        /* Navigation */
        nav {
            background: #222;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav ul {
            display: flex;
            justify-content: center;
            list-style: none;
        }

        nav ul li {
            margin: 0 15px;
            position: relative;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            padding: 15px 20px;
            display: block;
            transition: 0.3s;
        }

        nav ul li a:hover {
            background: #ffcc00;
            color: black;
            border-radius: 5px;
        }

        /* Main layout */
        .container {
            display: flex;
            margin: 20px;
            gap: 20px;
        }

        /* Content */
        .content {
            flex: 3;
            background: white;
            padding: 20px;
            border: 2px solid #ddd;
            outline: 4px dashed #2a5298;
            outline-offset: 8px;
            position: relative;
        }

        .content h2 {
            margin-bottom: 10px;
            color: #1e3c72;
        }

        .content p {
            line-height: 1.6;
        }

        /* Sidebar */
        .sidebar {
            flex: 1;
            background: #e8f0ff;
            padding: 20px;
            border-left: 5px solid #1e3c72;
            position: relative;
        }

        .sidebar h3 {
            margin-bottom: 10px;
        }

        .note {
            background: #ffeb99;
            padding: 10px;
            border: 1px solid #e0b800;
            position: absolute;
            bottom: 20px;
            right: 20px;
            font-size: 14px;
        }

        /* Footer */
        footer {
            background: #1e3c72;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 20px;
            border-top: 5px solid #ffcc00;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>My Creative Webpage</h1>
        <p>A Stylish Layout using CSS</p>
    </header>

    <!-- Navigation -->
    <nav>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Gallery</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>

    <!-- Main Content and Sidebar -->
    <div class="container">
        <section class="content">
            <h2>Welcome to My Website</h2>
            <p>
                This content section demonstrates the use of the CSS Box Model with
                margin, padding, border, and outline effects. It is styled uniquely
                for a modern appearance.
            </p>
        </section>

        <aside class="sidebar">
            <h3>Quick Links</h3>
            <ul>
                <li>HTML Tutorial</li>
                <li>CSS Guide</li>
                <li>JavaScript Tips</li>
            </ul>
            <div class="note">New Update!</div>
        </aside>
    </div>

    <!-- Footer -->
    <footer>
        <p>© 2026 My Creative Webpage | Designed by You</p>
    </footer>

</body>
</html>
